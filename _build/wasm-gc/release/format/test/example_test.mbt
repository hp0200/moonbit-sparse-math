// 定义一个普通函数承载完整的示例流程，方便用户阅读也可以在其他代码中直接复用。

///|
fn run_medical_example() -> Unit {
  // 声明病区数量为 4，后续输出说明和矩阵构造都围绕这四个病区展开。
  let ward_count = 4
  // 定义四个病区的显示名称，让后续输出具有明确的医疗业务含义。
  let ward_names : Array[String] = [
    "心内科", "呼吸科", "康复科", "急诊观察区",
  ]
  // 输出示例标题，让用户在终端中一眼看出这是医疗病区患者流转案例。
  println("=== 医疗病区患者流转稀疏矩阵示例 ===")
  // 输出参与模拟的病区数量，明确当前网络规模。
  println("本次模拟包含 \{ward_count} 个病区。")

  // 定义一个 4x4 的患者流转矩阵，每一行表示患者从当前病区流向各病区的概率。
  let flow_dense : Array[Array[Double]] = [
    // 第一行表示心内科患者主要留在本科室，同时少量流向呼吸科、康复科和急诊观察区。
    [0.80, 0.10, 0.05, 0.05],
    // 第二行表示呼吸科患者主要留在本科室，并与其他病区保持较低的流转概率。
    [0.10, 0.75, 0.10, 0.05],
    // 第三行表示康复科患者主要留在本科室，少量流向心内科、呼吸科和急诊观察区。
    [0.05, 0.10, 0.80, 0.05],
    // 第四行表示急诊观察区患者主要留在观察区，同时向其他专科病区分流。
    [0.10, 0.05, 0.10, 0.75],
  ]

  // 调用 from_dense 将普通二维数组转换成 CSR 稀疏矩阵，为后续高效计算做准备。
  let patient_flow = @core.from_dense(flow_dense, 0.0)
  // 调用稀疏矩阵诊断接口判断矩阵是否具有对角占优性质，用来评估患者流转系统稳定性。
  let is_healthy = @algebra.is_diagonally_dominant(patient_flow)
  // 根据诊断结果生成更容易理解的医疗业务说明，避免直接向用户输出单纯的布尔值。
  let diagnosis = if is_healthy {
    // 当矩阵对角占优时，说明各病区患者主要留在本地，系统整体具有较好的稳定性。
    "健康：矩阵对角占优，病区流转网络具有稳定收敛趋势。"
  } else {
    // 当矩阵不满足对角占优时，提示用户当前患者流转可能导致病区人数剧烈波动。
    "警告：矩阵不满足对角占优，病区流转网络可能存在波动风险。"
  }
  // 打印健康度诊断结果，让用户直接看到矩阵性质对应的业务含义。
  println("矩阵健康度诊断结果：\{diagnosis}")

  // 定义当前四个病区的患者人数向量，依次对应心内科、呼吸科、康复科和急诊观察区。
  let current_patients : Array[Double] = [120.0, 80.0, 60.0, 40.0]
  // 调用 spmv 执行稀疏矩阵乘向量，计算下一轮四个病区的预测患者人数。
  let next_patients = @core.spmv(patient_flow, current_patients).unwrap()
  // 打印当前患者分布标题，方便用户与后续预测结果进行对照。
  println("当前患者分布：")
  // 逐个病区输出当前患者人数，避免一次性打印数组造成阅读困难。
  for i = 0; i < current_patients.length(); i = i + 1 {
    // 结合病区名称和具体人数输出，让示例结果更接近真实业务报表。
    println("\{ward_names[i]}：\{current_patients[i]} 人")
  }
  // 打印矩阵乘向量的预测结果标题，展示稀疏矩阵在医疗资源调度中的实际用途。
  println("下一轮病区患者预测：")
  // 逐个病区输出预测患者人数，便于医院管理者直接理解每个病区的变化。
  for i = 0; i < next_patients.length(); i = i + 1 {
    // 输出病区名称和预测人数，形成清晰且可直接展示的预测结果。
    println("\{ward_names[i]}：\{next_patients[i]} 人")
  }

  // 构造一个 3x3 对称正定矩阵，用于演示 PCG 求解器在稳定线性系统上的求解过程。
  let system_dense : Array[Array[Double]] = [
    // 第一行提供第一个方程，并保证矩阵的主对角线元素足够强。
    [4.0, 1.0, 0.0],
    // 第二行与第一行对称，同时连接第三个未知量，保持矩阵的正定性。
    [1.0, 3.0, 1.0],
    // 第三行与第二行对称，用于构成一个适合 PCG 求解的简单线性方程组。
    [0.0, 1.0, 2.0],
  ]
  // 将线性方程组的系数矩阵转换为 CSR 稀疏矩阵，直接复用库中的稀疏存储能力。
  let system_matrix = @core.from_dense(system_dense, 0.0)
  // 定义线性方程组右侧的常数向量，与 3x3 系数矩阵的维度保持一致。
  let right_hand_side : Array[Double] = [1.0, 2.0, 3.0]
  // 调用 pcg_solve 使用 Jacobi 预条件共轭梯度法求解，并设置较严格的收敛容差。
  let solve_result = @solvers.pcg_solve(
    system_matrix, right_hand_side, 1.0e-10, 100,
  )
  // 使用 match 安全处理 Result 返回值，分别覆盖求解成功和失败两种场景。
  match solve_result {
    // 当求解器返回 Ok 时，取出解向量并打印，展示正常业务路径的处理方式。
    Ok(solution) => {
      // 先打印求解成功提示，说明 PCG 已经收敛到满足容差的数值解。
      println("PCG 线性方程组求解成功，解向量如下：")
      // 遍历解向量中的每一个分量，让用户能够清楚看到每个未知量的结果。
      for i = 0; i < solution.length(); i = i + 1 {
        // 打印当前未知量的下标和数值，形成清晰易读的求解结果。
        println("x[\{i}] = \{solution[i]}")
      }
    }
    // 当求解器返回 Err 时，打印错误信息，避免示例程序因业务异常直接崩溃。
    Err(message) => println("PCG 线性方程组求解失败：\{message}")
  }
  // 输出结束提示，标记整个医疗稀疏矩阵示例已经完整执行。
  println("=== 示例执行结束 ===")
}

// 定义一个轻量测试入口，仅用于在当前库包中通过 moon test 实际运行这份普通示例流程。

///|
test "medical sparse matrix example" {
  // 调用前面定义的普通示例函数，完整执行患者流转、诊断、预测和 PCG 求解流程。
  run_medical_example()
}
